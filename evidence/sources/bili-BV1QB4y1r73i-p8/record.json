    "items": [
      {
        "id": "P8-01",
        "item": "事实、意图与接收；观众分心与有效看到的区别",
        "source": {
          "lines": [
            1,
            65
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            51,
            51
          ],
          "quote": "## 本课速览"
        }
      },
      {
        "id": "P8-02",
        "item": "分格、先放主镜；必要事件链与连接镜的作用",
        "source": {
          "lines": [
            66,
            127
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            69,
            69
          ],
          "quote": "### 分格后先放必要主镜"
        }
      },
      {
        "id": "P8-03",
        "item": "借琴对白正反打、脸已可见可不切、吉他插入",
        "source": {
          "lines": [
            128,
            167
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            77,
            77
          ],
          "quote": "### 借吉他的对话：常规反打与物件插入"
        }
      },
      {
        "id": "P8-04",
        "item": "时长与景别两种办法、本课只景别；整体趋势、前倾、摇大腿骨",
        "source": {
          "lines": [
            168,
            257
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            83,
            83
          ],
          "quote": "## 冲突的递进：整体趋势比逐镜变化更重要"
        }
      },
      {
        "id": "P8-05",
        "item": "由紧切松及讲师描述的突然安静、变化强调",
        "source": {
          "lines": [
            258,
            284
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            89,
            89
          ],
          "quote": "到猪皮哥出事、倒在床上的主镜，突然放成较全的画面。"
        }
      },
      {
        "id": "P8-06",
        "item": "请求弹唱、拒绝到答应、拿琴与米格惊讶、舒缓松景",
        "source": {
          "lines": [
            285,
            313
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            93,
            93
          ],
          "quote": "### 拿琴到开始演唱"
        }
      },
      {
        "id": "P8-07",
        "item": "察觉米格在听使埃克托改词，猪皮哥不满的反应链",
        "source": {
          "lines": [
            314,
            334
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            99,
            99
          ],
          "quote": "### 为什么歌词改变时要切听者"
        }
      },
      {
        "id": "P8-08",
        "item": "先熟悉双人主镜角度以对比消失前后的有无",
        "source": {
          "lines": [
            335,
            355
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            105,
            105
          ],
          "quote": "### 消失之前，为什么再给一次双人主镜"
        }
      },
      {
        "id": "P8-09",
        "item": "歌词指代切猪皮哥、歌曲收尾感谢、后续主镜衔接",
        "source": {
          "lines": [
            356,
            388
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            109,
            109
          ],
          "quote": "歌词提到“要不是我奇丑无比”时，老师选择切猪皮哥"
        }
      },
      {
        "id": "P8-10",
        "item": "扒既有影片的假装设计身份，回顾的独特信息并入各节",
        "source": {
          "lines": [
            389,
            467
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            109,
            109
          ],
          "quote": "后面的 `11:29—13:31` 回顾沿用这条链"
        }
      },
      {
        "id": "P8-11",
        "item": "讲全仍流水账；消失重点的各人、发亮、全景、落帽与狗的逐步强调",
        "source": {
          "lines": [
            468,
            560
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            113,
            113
          ],
          "quote": "### 本场最重要的事件：猪皮哥消失"
        }
      },
      {
        "id": "P8-12",
        "item": "对全片重要的弹唱伏笔：提前关联与米格各阶段多次反应",
        "source": {
          "lines": [
            561,
            665
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            126,
            126
          ],
          "quote": "### 对全片重要的伏笔：埃克托会弹、会唱"
        }
      },
      {
        "id": "P8-13",
        "item": "分格、选画面对齐、接顺、强调重点的工作顺序",
        "source": {
          "lines": [
            666,
            711
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            152,
            152
          ],
          "quote": "老师最后把过程归纳成："
        }
      },
      {
        "id": "P8-14",
        "item": "假设琴是重点；减少早段反打、长全景后突切琴特写",
        "source": {
          "lines": [
            712,
            746
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            142,
            148
          ],
          "quote": "## 弱化非重点：不一定靠继续加镜头"
        }
      },
      {
        "id": "P8-15",
        "item": "强调和弱化促接收、情绪、代入是课堂解释而非观众保证",
        "source": {
          "lines": [
            747,
            769
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            63,
            63
          ],
          "quote": "老师把接收信息、产生情绪、进入情境和觉得好看联系起来"
        }
      },
      {
        "id": "P8-16",
        "item": "现成画面限制、平面机位之外的视高与景别；结尾无新知识",
        "source": {
          "lines": [
            770,
            804
          ]
        },
        "status": "保留",
        "note": {
          "lines": [
            154,
            154
          ],
          "quote": "这次用了现成影片画面；如果自己设计，确定平面位置后仍要决定摄影机多高"
        }
      }
    ]
  },
