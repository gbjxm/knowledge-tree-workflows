      ]
    ],
    "items": [
      {
        "id": "P43-U01",
        "item": "推、拉、摇、移及升、降、甩、跟的分类。物理运动方向、速度和跟随功能不是同一层级，不把八类写成互斥且穷尽的唯一分类。",
        "source": {
          "lines": [
            6,
            17
          ]
        },
        "note": {
          "lines": [
            43,
            48
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U02",
        "item": "推镜头由较大范围走向局部细节，引导注意与强调；具体情绪取决于内容和速度。",
        "source": {
          "lines": [
            18,
            26
          ]
        },
        "note": {
          "lines": [
            43,
            48
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U03",
        "item": "拉镜头由局部走向环境；推拉可由变焦或机位移动实现，外观相近不表示空间效果等同。",
        "source": {
          "lines": [
            27,
            35
          ]
        },
        "note": {
          "lines": [
            43,
            48
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U04",
        "item": "光学变焦：广角至长焦及反向；区分焦距、视角与主体成像大小。原课字幕术语待核。",
        "source": {
          "lines": [
            36,
            43
          ]
        },
        "note": {
          "lines": [
            49,
            62
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U05",
        "item": "摄影机实际前后移动、轨道辅助；不把课堂历史叙述写成未经核实的发明史。",
        "source": {
          "lines": [
            44,
            55
          ]
        },
        "note": {
          "lines": [
            49,
            62
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U06",
        "item": "同机位变焦与后期放大对照。视点不变不等于画面信息完全不变，数字裁切也不无条件等于光学变焦；需限定取景、分辨率及光学效果。",
        "source": {
          "lines": [
            56,
            69
          ]
        },
        "note": {
          "lines": [
            49,
            62
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U07",
        "item": "移动后遮挡、物体关系与可见范围改变。转写“视角不变／越来越宽”混杂，不能写成定焦前推必然增大镜头视场角；区分视点、透视、视差、画框范围。",
        "source": {
          "lines": [
            70,
            83
          ]
        },
        "note": {
          "lines": [
            49,
            62
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U08",
        "item": "以人走近的体验解释偏好移动式推拉；“电影禁用变焦”等是课堂概括，不是行业禁令，眼睛类比也不当作生理学论证。",
        "source": {
          "lines": [
            84,
            106
          ]
        },
        "note": {
          "lines": [
            49,
            62
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U09",
        "item": "推近的细节强调应有表达必要；不提升为“只有原先不可辨细节才准推”的硬规则。",
        "source": {
          "lines": [
            107,
            121
          ]
        },
        "note": {
          "lines": [
            63,
            70
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U10",
        "item": "哭泣采访中推向眼泪的例子：主观强调、干预观看与节制，属于新闻采访语境的取舍，不概括全部采访或当下行业统计。",
        "source": {
          "lines": [
            122,
            151
          ]
        },
        "note": {
          "lines": [
            63,
            70
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U11",
        "item": "拉开揭示环境与新信息；单衣者周围皆穿冬衣是课堂假设，不能写成已经看到的示范画面。",
        "source": {
          "lines": [
            152,
            174
          ]
        },
        "note": {
          "lines": [
            63,
            70
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U12",
        "item": "推进入、拉退出与段落开合的常见表达；不是开场必须推、结尾必须拉。",
        "source": {
          "lines": [
            175,
            191
          ]
        },
        "note": {
          "lines": [
            63,
            70
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      },
      {
        "id": "P43-U13",
        "item": "起幅—运动—落幅及最终信息落点。ASR“起伏／落伏”需校词；拍摄规划不等于每个成片镜头必须保留静止的起落幅。",
        "source": {
          "lines": [
            192,
            215
          ]
        },
        "note": {
          "lines": [
            71,
            76
          ]
        },
        "status": "合并",
        "reason": "按课程知识问题合并；概念限定及原帧文字另记。文字登记闭合不证明原声或全课连续视频已审。"
      }
    ]
  },
