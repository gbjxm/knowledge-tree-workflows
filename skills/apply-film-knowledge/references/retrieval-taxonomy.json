{
  "version": 1,
  "rules": [
    {"id": "sudden-character-change", "any": ["突然就变", "突然成长", "突然成熟", "转变不可信", "转变为什么不可信", "忽然像换了个人"], "add": ["人物弧光", "人物变化", "选择 代价 新状态", "共情"]},
    {"id": "short-form-compression", "any": ["三分钟塞不下", "短片塞不下", "哪些东西不能丢", "故事铺得太大", "片长只有三分钟", "背景太多", "最重要那条线"], "add": ["短篇媒介", "结构压缩", "不可丢失因果链", "决定性切片"]},
    {"id": "short-causal-cut", "all": ["分钟", "因果"], "add": ["短篇媒介", "结构压缩", "不可丢失因果链", "决定性切片"]},
    {"id": "rough-to-lock", "any": ["粗剪一直推进不到锁画", "粗剪到不了锁画", "推进不到锁画"], "add": ["真实素材", "Rough Fine Picture Lock候选", "画面剪辑", "锁画候选"]},
    {"id": "standing-dialogue", "any": ["站着说话", "镜头怎么拍才不死", "只有正反打", "正反打还是很僵"], "add": ["场面调度", "镜头覆盖", "人物空间", "摄影机"]},
    {"id": "asset-continuity", "any": ["衣服和道具对不上", "服装道具对不上", "资产不一致", "每个镜头不一样", "不同take", "颜色和状态都变"], "add": ["服化道", "制作连续性", "状态链", "跨镜", "可追溯"]},
    {"id": "asset-disappears", "any": ["忽有忽无", "一会儿有一会儿没", "突然不见了"], "add": ["道具状态", "制作连续性", "跨镜", "可追溯"]},
    {"id": "world-coherence", "any": ["不在一个世界", "人物和场景不一致"], "add": ["生产设计", "空间", "材质", "共同表达人物和世界"]},
    {"id": "reverse-angle-continuity", "any": ["反打之后方向乱", "越轴", "屏幕方向乱", "方向连续性", "切镜方向"], "add": ["连续性剪辑", "镜头衔接", "轴线", "屏幕方向"]},
    {"id": "eyeline-reverse", "all": ["正反打", "方向"], "add": ["连续性剪辑", "镜头衔接", "视线匹配", "轴线"]},
    {"id": "edit-ingest", "any": ["能不能进剪辑", "能不能入剪", "可不可以剪", "代理文件重连", "代理替换", "重连后时长对不上", "声音比画面"], "add": ["AI生成素材", "可追溯身份", "时间真实性", "技术可用性", "画音同步", "Relink"]},
    {"id": "dialogue-space", "any": ["像录音棚", "对白空间断", "空间断了", "房间感", "每一句都在跳", "大房间", "贴着麦克风"], "add": ["对白编辑", "空间可信", "环境连续", "保留表演"]},
    {"id": "dialogue-noise-continuity", "any": ["环境底噪", "底噪都不一样"], "add": ["对白编辑", "环境连续", "room tone", "空间可信"]},
    {"id": "music-carries-drama", "any": ["没有音乐", "没情绪"], "all": [], "add": ["音乐叙事", "无配乐段落", "不替代戏剧行动", "Spotting"]},
    {"id": "music-removed", "any": ["音乐撤掉", "音乐拿掉", "临时音乐", "删掉音乐"], "add": ["音乐叙事", "无配乐段落", "不替代戏剧行动", "Spotting"]},
    {"id": "score-carries-drama", "all": ["配乐", "不成立"], "add": ["音乐叙事", "无配乐段落", "不替代戏剧行动", "Spotting"]},
    {"id": "master-version-integrity", "any": ["声画字幕没串版", "声画字幕串版", "最终导出版本"], "add": ["PIC AUD TEXT GFX", "MASTER-COMPOSITION", "母版QC", "恢复验证"]},
    {"id": "master-stale-cut", "any": ["旧剪辑", "母版已经换", "字幕文件绑的是旧"], "add": ["TEXT组件", "唯一CUT", "MASTER-COMPOSITION", "版本冻结", "母版QC"]},
    {"id": "luck-vs-process", "any": ["是不是运气", "只是运气", "偶然变好"], "add": ["过程质量", "单次结果", "执行与运气", "样本量", "提示词迭代"]}
  ]
}
